@page
@model IMS.RazorWebApp.Pages.Interviews.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<p>
    <a asp-page="Create">Create New</a>
</p>
<form method="get" class="form-inline mb-3">
    <div class="input-group">
        <input type="text" class="form-control" asp-for="SearchValue" placeholder="Search" />
        <div class="input-group-append">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </div>
</form>
<table class="table">
    <thead>
        <tr>

            <th>
                @Html.DisplayNameFor(model => model.InterviewsInfo[0].InterviewMode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InterviewsInfo[0].Content)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InterviewsInfo[0].Mentor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InterviewsInfo[0].Intern)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InterviewsInfo[0].Position)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InterviewsInfo[0].Location)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InterviewsInfo[0].Time)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InterviewsInfo[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InterviewsInfo[0].Feedback)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InterviewsInfo[0].Result)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.InterviewsInfo) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.InterviewMode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Content)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Mentor.FullName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Intern.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Position)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Location)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.Time)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Feedback)
                </td> 
                <td>
                    @Html.DisplayFor(modelItem => item.Result)
                </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.InterviewinfoId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.InterviewinfoId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.InterviewinfoId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
@{
    var prevDisabled = !Model.InterviewsInfo.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.InterviewsInfo.HasNextPage ? "disabled" : "";
}
<div class="flex flex-row justify-content-evenly">
    <div class="flex-column">
        <a asp-page="./Index"
           asp-route-pageIndex="@(Model.InterviewsInfo.PageIndex - 1)"
           asp-route-pageSize="@(Model.PageSize)"
           class="btn btn-primary @prevDisabled">
            Previous
        </a>
        <a asp-page="./Index"
           asp-route-pageIndex="@(Model.InterviewsInfo.PageIndex + 1)"
           asp-route-pageSize="@(Model.PageSize)"
           class="btn btn-primary @nextDisabled">
            Next
        </a>
    </div>
</div>
