@page
@model IMS.RazorWebApp.Pages.Task.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<form method="get" class="form-inline mb-3">
    <div class="input-group">
        <input type="text" class="form-control" asp-for="Search" placeholder="Search" />
        <div class="input-group-append">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Task[0].TaskId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Task[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Task[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Task[0].InternId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Task[0].MentorId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Task[0].Priority)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Task[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Task[0].CreateDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Task[0].DueDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Task[0].CompletionPercentage)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Task) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TaskId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InternId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MentorId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Priority)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreateDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DueDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CompletionPercentage)
            </td>

            <td>
                <a asp-page="./Edit" asp-route-id="@item.TaskId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.TaskId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.TaskId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
@{
    var prevDisabled = !Model.Task.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.Task.HasNextPage ? "disabled" : "";
}
<div class="flex flex-row justify-content-evenly">
    <div class="flex-column">
        <a asp-page="./Index"
           asp-route-pageIndex="@(Model.Task.PageIndex - 1)"
           asp-route-pageSize="@(Model.PageSize)"
           class="btn btn-primary @prevDisabled">
            Previous
        </a>
        <a asp-page="./Index"
           asp-route-pageIndex="@(Model.Task.PageIndex + 1)"
           asp-route-pageSize="@(Model.PageSize)"
           class="btn btn-primary @nextDisabled">
            Next
        </a>
    </div>
</div>